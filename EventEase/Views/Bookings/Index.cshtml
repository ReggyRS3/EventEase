@model IEnumerable<EventEase.Models.BookingDetails>

@{
    ViewData["Title"] = "Bookings";
    var venueAvailable = ViewData["VenueAvailable"] as bool?;
}

<h1>Bookings</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Booking</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Search</label>
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control"
               placeholder="Booking ID or Event Name" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Event Type</label>
        <select name="eventTypeId" class="form-select" asp-items="ViewBag.EventTypeId">
            <option value="">All types</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="endDate" value="@ViewData["EndDate"]" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Venue Availability</label>
        <select name="venueAvailable" class="form-select">
            <option value="">All venues</option>
            <option value="true" selected="@(venueAvailable == true)">Available</option>
            <option value="false" selected="@(venueAvailable == false)">Unavailable</option>
        </select>
    </div>
    <div class="col-md-1 d-flex gap-1">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Booking ID</th>
                <th>Booking Date</th>
                <th>Event</th>
                <th>Event Type</th>
                <th>Venue</th>
                <th>Location</th>
                <th>Capacity</th>
                <th>Available</th>
                <th>Image</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.BookingId</td>
                    <td>@item.BookingDate.ToString("yyyy/MM/dd HH:mm")</td>
                    <td>@item.EventName</td>
                    <td>@(item.EventTypeName ?? "Not set")</td>
                    <td>@item.VenueName</td>
                    <td>@item.Location</td>
                    <td>@item.Capacity</td>
                    <td>
                        @if (item.VenueIsAvailable)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.VenueImageUrl))
                        {
                            <img src="@item.VenueImageUrl" alt="@item.VenueName" style="width:100px; height:62px; object-fit:cover; border-radius:6px;" />
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.BookingId">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}